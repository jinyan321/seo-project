# Copy to .env and fill in. Never commit .env.

# API keys (the worker is the only process that uses them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PROVIDER_MODE=live            # "fake" = no API calls, no cost

# First admin, created at web start-up if there are no users yet
APP_USERNAME=admin
APP_PASSWORD=
SESSION_SECRET=               # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECURE=true            # false only for plain-http local testing

# Database. docker-compose builds DATABASE_URL from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
# DATABASE_URL=sqlite:///./data/tracker.db   # local dev without Docker

# Public hostname for Caddy HTTPS (localhost for a local test)
DOMAIN=localhost

# Ops
MAX_DAILY_USD=5
ALERT_WEBHOOK_URL=            # Slack-compatible incoming webhook
HC_PING_URL=                  # https://hc-ping.com/<uuid>, set the check period to 1 day
BACKUP_KEEP_DAYS=30
